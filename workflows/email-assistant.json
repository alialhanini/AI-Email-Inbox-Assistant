      "parameters": {
        "jsCode": "const item = $input.item;\n\nconst attachments = Object.keys(item.binary ?? {}).map(key => ({\n  key,\n  fileName: item.binary[key].fileName,\n  mimeType: item.binary[key].mimeType,\n  fileSize: item.binary[key].fileSize,\n}));\n\nitem.json.attachments = attachments;\n\nreturn item;"
      },
