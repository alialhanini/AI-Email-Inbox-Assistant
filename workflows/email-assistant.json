      "parameters": {
        "jsCode": "const item = $input.item;\nconst binary = item.binary ?? {};\n\nconst attachmentKeys = Object.keys(binary);\n\nreturn attachmentKeys.map((key) => {\n  const attachment = binary[key];\n\n  return {\n    json: {\n      attachmentKey: key,\n      fileName: attachment.fileName || key,\n      mimeType: attachment.mimeType,\n      fileSize: attachment.fileSize,\n    },\n    binary: {\n      attachment_0: {\n        ...attachment,\n        fileName: attachment.fileName || key,\n      },\n    },\n  };\n});"
      },
