    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an AI Email Assistant.\n\nAnalyze this email:\nFrom: {{ $('Gmail Trigger').item.json.from.text }}\nTo: {{ $('Gmail Trigger').item.json.to.text }}\nSubject: {{ $('Gmail Trigger').item.json.subject }}\nEmail:\n{{ $('Gmail Trigger').item.json.text }}\n\nPRIORITY RULES:\n\n* Urgent: Immediate action is required, such as emergencies, account security threats, deadlines within hours, or serious problems that cannot wait. If the email explicitly states a time-sensitive consequence (e.g. \"within X hours\", \"account suspended\", \"security breach\", \"action required immediately\"), classify as Urgent even if the action itself seems simple.\n* High: Important action is required soon, such as a confirmed interview happening within 24 hours, a job offer requiring a quick response, payment problems, or critical work matters.\n* Medium: The email requires a response or action, but there is no immediate deadline or urgent consequence. Examples include interview scheduling with several available dates/times, job application follow-ups, recruiter messages, meeting requests, and normal work requests.\n* Low: Informational emails, newsletters, notifications, advertisements, receipts, general updates, or emails that do not require action.\n\nIMPORTANT:\nDo not classify an email as High simply because it is related to a job opportunity or requires a reply.\nIf there is no urgent deadline or immediate consequence, prefer Medium.\n\nDetermine the sender and recipient from the actual From and To fields.\nWrite the draft reply naturally with proper paragraphs, in a professional tone.\nKeep the summary concise (1-2 sentences).\nIf REQUIRES REPLY is No, set draft_reply to \"No reply needed\".\n\nExtract all URLs/links and phone numbers from the email.\nDo not invent, modify, shorten, or remove URLs or phone numbers.\nIf none exist, return an empty array.\n\nInclude important URLs and phone numbers naturally in the summary when they are relevant to the user.\n",
        "hasOutputParser": true,
        "messages": {
          "messageValues": []
        },
        "batching": {}
      },
      "id": "00fcfbe7-2076-4c23-ab8d-265a596c9002",
      "name": "Basic LLM Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"category\": {\n      \"type\": \"string\",\n      \"description\": \"The general category of the email, e.g. Job Opportunity, Security Alert, Newsletter, Meeting Request\"\n    },\n    \"priority\": {\n      \"type\": \"string\",\n      \"enum\": [\"Low\", \"Medium\", \"High\", \"Urgent\"],\n      \"description\": \"The priority level based on the priority rules\"\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"A short concise 1-2 sentence summary of the email. Include important phone numbers, URLs, links, dates, times, names, or other critical details when relevant.\"\n    },\n    \"action\": {\n      \"type\": \"string\",\n      \"description\": \"The recommended next action\"\n    },\n    \"requires_reply\": {\n      \"type\": \"string\",\n      \"enum\": [\"Yes\", \"No\"],\n      \"description\": \"Whether this email requires a reply\"\n    },\n    \"draft_reply\": {\n      \"type\": \"string\",\n      \"description\": \"A professional draft reply if needed, otherwise 'No reply needed'\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"All URLs or clickable links found in the email. Do not invent or modify them. Return an empty array if none exist.\"\n    },\n    \"phone_numbers\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"All phone numbers found in the email. Do not invent or modify them. Return an empty array if none exist.\"\n    }\n  },\n  \"required\": [\n    \"category\",\n    \"priority\",\n    \"summary\",\n    \"action\",\n    \"requires_reply\",\n    \"draft_reply\",\n    \"links\",\n    \"phone_numbers\"\n  ]\n}"
      },
