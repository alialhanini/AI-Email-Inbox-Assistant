    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "{{WHATSAPP_PHONE_NUMBER_ID}}",
        "recipientPhoneNumber": "{{YOUR_WHATSAPP_NUMBER}}",
        "textBody": "=📧 EMAIL ANALYSIS\n\nFrom: {{ $('Gmail Trigger').item.json.from.text }}\nTo: {{ $('Gmail Trigger').item.json.to.text }}\nSubject: {{ $('Gmail Trigger').item.json.subject }}\n\n━━━━━━━━━━━━━━\n\n📂 Category:\n{{ $('Basic LLM Chain').item.json.output.category }}\n\n🚨 Priority:\n{{ $('Basic LLM Chain').item.json.output.priority }}\n\n📝 Summary:\n{{ $('Basic LLM Chain').item.json.output.summary }}\n\n🎯 Action:\n{{ $('Basic LLM Chain').item.json.output.action }}\n\n↩️ Requires Reply:\n{{ $('Basic LLM Chain').item.json.output.requires_reply }}\n\n━━━━━━━━━━━━━━\n\n✉️ DRAFT REPLY\n\n{{ $('Basic LLM Chain').item.json.output.draft_reply }}\n\n━━━━━━━━━━━━━━\n\n📞 Phone Numbers:\n{{ $('Basic LLM Chain').item.json.output.phone_numbers.join(', ') }}\n\n🔗 Links:\n{{ \n  $('Basic LLM Chain').item.json.output.links.length\n    ? $('Basic LLM Chain').item.json.output.links.slice(0, 3).map((link, i) => `${i + 1}. ${link.length > 250 ? link.slice(0, 250) + '...' : link}`).join('\\n')\n    : 'No links'\n}}",
        "additionalFields": {}
      },
